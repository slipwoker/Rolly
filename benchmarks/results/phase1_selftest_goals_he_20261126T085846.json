            "turns": [
                {
                    "label": "opener",
                    "seq": 1,
                    "text": "בוקר טוב, מה השם וספר לי לאן נוסעים עכשיו?",
                    "audio_s": 3.07,
                    "interrupted": false,
                    "proactive": true
                },
                {
                    "label": "reply1",
                    "seq": 2,
                    "text": "נעים מאוד דני. אני תמיד חושב שהנסיעות האלה בבוקר הן הזמן הכי טוב לסיים פודקאסטים.",
                    "audio_s": 5.78,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 421,
                    "user_said": "היי, קוראים לי דני."
                },
                {
                    "label": "reply2",
                    "seq": 3,
                    "text": "זה נשמע כמו פרויקט ענק, אני חייב לדעת מה התחום שאתה רוצה להפוך לעצמאי בו?",
                    "audio_s": 4.67,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 820,
                    "user_said": "אני רוצה לנצל את הנסיעות כדי לתכנן את המעבר שלי לעבודה עצמאית."
                },
                {
                    "label": "reply3",
                    "seq": 4,
                    "text": "שמתי את זה בצד, זה יחזור אליך. רשימה כזו יכולה להיות מאוד מתישה אם מנסים לתפוס הכל בבת אחת.",
                    "audio_s": 6.76,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 554,
                    "user_said": "אני חושב שהצעד הראשון הוא לבנות רשימה של עשרה לקוחות אפשריים."
                },
                {
                    "label": "reply4",
                    "seq": 5,
                    "text": "ביי דני, שיהיה בהצלחה.",
                    "audio_s": 2.3,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 198,
                    "user_said": "טוב, הגעתי, ביי."
