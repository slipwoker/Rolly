            "ok": true,
            "lang": "he",
            "turns": [
                {
                    "label": "opener",
                    "seq": 1,
                    "text": "בוקר טוב. מה השם שלך וספר לי, לאן נוסעים בבוקר כזה?",
                    "audio_s": 5.05,
                    "interrupted": false,
                    "proactive": true
                },
                {
                    "label": "reply1",
                    "seq": 3,
                    "text": "נעים מאוד, נועה. אז מה התוכנית להיום?",
                    "audio_s": 3.13,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 256,
                    "user_said": "היי! קוראים לי נועה."
                },
                {
                    "label": "reply2",
                    "seq": 4,
                    "text": "ספרדית זה קטע, השפה שם נשמעת ממש כמו שיר.",
                    "audio_s": 3.34,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 663,
                    "user_said": "בנסיעות אני הכי רוצה ללמוד משהו חדש, אולי ספרדית."
                },
                {
                    "label": "reply3",
                    "seq": 5,
                    "text": "זה נשמע כמו שדרוג רציני, הלקוחות שם בטח מאוד מעריכים את זה.",
                    "audio_s": 4.6,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 372,
                    "user_said": "אני חושבת שזה יעזור לי בעבודה, אני עובדת עם לקוחות מדרום אמריקה."
                },
                {
                    "label": "reply4",
                    "seq": 6,
                    "text": "קפה חזק יכול לעזור, או אולי פודקאסט מעניין שיעיר אותך.",
                    "audio_s": 3.69,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 538,
                    "user_said": "אני די עייפה היום, אבל זה בסדר."
                },
                {
                    "label": "reply5",
                    "seq": 7,
                    "text": "וואו, גוגל זה לא דבר כזה פשוט, זה בטח דורש המון ריכוז.",
                    "audio_s": 4.53,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 421,
                    "user_said": "אני מהנדס תוכנה בגוגל ואני נשוי."
                },
                {
                    "label": "reply6",
                    "seq": 8,
                    "text": "ביי, נתראה בנסיעה הבאה.",
                    "audio_s": 2.23,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 430,
                    "user_said": "טוב, נמשיך בפעם הבאה, ביי."
