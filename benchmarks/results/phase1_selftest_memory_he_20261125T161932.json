            "lang": "he",
            "turns": [
                {
                    "label": "opener",
                    "seq": 1,
                    "text": "ערב טוב. מה השם, ואיך הכיוון להיום?",
                    "audio_s": 3.65,
                    "interrupted": false,
                    "proactive": true
                },
                {
                    "label": "reply1",
                    "seq": 3,
                    "text": "נעים מאוד, נועה. אז מה הכיוון להיום, סתם להעביר את הזמן או יש משהו שרוצים לחשוב עליו?",
                    "audio_s": 6.06,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 189,
                    "user_said": "היי! קוראים לי נועה."
                },
                {
                    "label": "reply2",
                    "seq": 4,
                    "text": "וואלה, ספרדית זה אחלה רעיון. יש כבר משהו שמתכננים ללמוד או שזה רק רעיון שעלה עכשיו?",
                    "audio_s": 5.99,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 462,
                    "user_said": "בנסיעות אני הכי רוצה ללמוד משהו חדש, אולי ספרדית."
                },
                {
                    "label": "reply3",
                    "seq": 5,
                    "text": "זה נשמע ממש שימושי. זה משהו שבאמת נחוץ ביומיום בעבודה או שזה יותר בשביל הבונוס?",
                    "audio_s": 5.78,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 426,
                    "user_said": "אני חושבת שזה יעזור לי בעבודה, אני עובדת עם לקוחות מדרום אמריקה."
                },
                {
                    "label": "reply4",
                    "seq": 6,
                    "text": "אוי, אז אולי עדיף פשוט לשחרר קצת ולא לדחוף למידה עכשיו?",
                    "audio_s": 3.76,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 387,
                    "user_said": "אני די עייפה היום, אבל זה בסדר."
                },
                {
                    "label": "reply5",
                    "seq": 7,
                    "text": "וואלה, ממש מרשים. אז מה הכיוון להמשך הערב, פשוט לנוח?",
                    "audio_s": 4.67,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 453,
                    "user_said": "אני מהנדס תוכנה בגוגל ואני נשוי."
                },
                {
                    "label": "reply6",
                    "seq": 8,
                    "text": "סגור, תנוחי טוב. ביי.",
                    "audio_s": 2.79,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 388,
                    "user_said": "טוב, נמשיך בפעם הבאה, ביי."
