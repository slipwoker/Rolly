            "turns": [
                {
                    "label": "opener",
                    "seq": 1,
                    "text": "בוקר טוב. מה השם שלך וספר לי, לאן הנסיעה הזאת מובילה אותנו?",
                    "audio_s": 5.46,
                    "interrupted": false,
                    "proactive": true
                },
                {
                    "label": "reply1",
                    "seq": 2,
                    "text": "יוון זה תמיד רעיון מעולה, במיוחד אם תמצאו אי קצת שקט עם אוכל טוב.",
                    "audio_s": 4.81,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 537,
                    "user_said": "היי, קוראים לי דני, אני מתכנן טיול משפחתי ליוון בקיץ."
                },
                {
                    "label": "reply2",
                    "seq": 3,
                    "text": "אתונה יכולה להיות קצת עמוסה מדי עם הילדים, האיים הרבה יותר רגועים.",
                    "audio_s": 4.95,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 564,
                    "user_said": "עוד לא החלטתי אם לטוס לאתונה או לאחד האיים."
                },
                {
                    "label": "reply3",
                    "seq": 4,
                    "text": "לפעמים קל יותר פשוט לצאת לריצה קצרה בלי לחשוב על זה יותר מדי.",
                    "audio_s": 4.18,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 495,
                    "user_said": "וגם רציתי לחזור לרוץ פעמיים בשבוע, אבל אין לי כוח."
                },
                {
                    "label": "reply4",
                    "seq": 5,
                    "text": "ביי דני, תהנה.",
                    "audio_s": 1.53,
                    "interrupted": false,
                    "proactive": false,
                    "reply_latency_ms": 415,
                    "user_said": "טוב, הגעתי, נדבר, ביי."
