{
  "expo": {
    "name": "ROLLY",
    "slug": "rolly",
    "scheme": "rolly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.zappy.rolly",
      "supportsTablet": false,
      "icon": { "light": "./assets/icon.png", "dark": "./assets/icon-dark.png" },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ROLLY מקשיב לך בזמן שיחה קולית. ROLLY listens to you during a voice conversation.",
        "UIBackgroundModes": ["audio"],
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": ["he", "en"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-localization", { "supportsRTL": true }],
      "expo-font",
      ["expo-splash-screen", {
        "image": "./assets/splash-orb.png", "imageWidth": 180, "resizeMode": "contain", "backgroundColor": "#FFFFFF",
        "dark": { "image": "./assets/splash-orb.png", "backgroundColor": "#0D0B13" }
      }]
    ],
    "extra": {
      "apiUrl": "https://rolly-api.onrender.com",
      "supportsRTL": true,
      "eas": { "projectId": "270750de-fa01-4bdd-bc89-4a8d946e476a" }
    },
    "experiments": { "typedRoutes": false },
    "owner": "zappy-technologies-ltd"
  }
}
