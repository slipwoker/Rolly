{
  "expo": {
    "name": "ROLLY",
    "slug": "rolly",
    "scheme": "rolly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.zappy.rolly",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-fg.png", "backgroundImage": "./assets/adaptive-bg.png", "backgroundColor": "#7FA6FB" },
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MICROPHONE"]
    },
    "ios": {
      "bundleIdentifier": "com.zappy.rolly",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ROLLY מקשיב לך בזמן שיחה קולית. ROLLY listens to you during a voice conversation.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-avatar.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6FA",
          "dark": {
            "image": "./assets/splash-avatar-dark.png",
            "backgroundColor": "#0D0B13"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://rolly-api.onrender.com",
      "supportsRTL": true,
      "eas": {
        "projectId": "270750de-fa01-4bdd-bc89-4a8d946e476a"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "zappy-technologies-ltd",
    "android": {
      "package": "com.zappy.rolly"
    }
  }
}
