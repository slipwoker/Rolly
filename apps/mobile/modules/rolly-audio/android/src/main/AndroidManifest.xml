<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- microphone for the conversation; the runtime prompt is shown by RollyAudio.start() -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- communication mode, speakerphone and Bluetooth routing -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <!-- Bluetooth SCO (car hands-free) before Android 12; newer versions use setCommunicationDevice -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <!-- keep listening with the screen locked: a microphone foreground service while a conversation runs -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

  <application>
    <service
      android:name="com.zappy.rollyaudio.RollyAudioService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>
