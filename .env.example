# Copy to .env (never commit .env).  Only the variables you need.

# ---- access control (set both when the server is reachable from the internet) ----
ROLLY_ACCESS_TOKEN=            # shared secret for testers: open the app as /?token=...
ROLLY_ADMIN_TOKEN=             # reveals provider identities, un-blinded ratings and resource stats
ROLLY_BLIND_SALT=change-me     # changes the anonymous "Agent X" labelling

# ---- privacy ----
ROLLY_RETAIN_AUDIO=false               # raw user audio is never stored unless this is true
ROLLY_STORE_TRANSCRIPTS=true           # false = keep only the session summary
ROLLY_TRANSCRIPT_RETENTION_DAYS=30     # transcripts + telemetry older than this are purged daily

# ---- self-hosted modular pipeline ----
ROLLY_STT_MODEL_HE=ivrit-ai/whisper-large-v3-turbo-ct2        # Hebrew sessions
ROLLY_STT_MODEL_EN=deepdml/faster-whisper-large-v3-turbo-ct2  # English sessions (CPU-only laptops: "small" for both)
ROLLY_STT_DEVICE=auto                  # cuda | cpu | auto
ROLLY_STT_COMPUTE=default              # GPU: float16 ; CPU: int8
ROLLY_STT_WORKERS=1
ROLLY_LLM_BASE_URL=http://127.0.0.1:8081/v1   # vLLM / llama.cpp / any OpenAI-compatible server
ROLLY_LLM_MODEL=local
ROLLY_LLM_API_KEY=
ROLLY_TTS_PROVIDER=cpu                 # cuda on a GPU host
ROLLY_ENDPOINT_SILENCE_MS=544          # silence that ends the user's turn
ROLLY_EAGER_SILENCE_MS=256             # speculative processing starts here (0 = off)
ROLLY_WARM_PROVIDERS=modular-selfhosted

# ---- hybrid: commercial LLM behind an OpenAI-compatible endpoint ----
ROLLY_HYBRID_LLM_BASE_URL=             # e.g. https://generativelanguage.googleapis.com/v1beta/openai
ROLLY_HYBRID_LLM_MODEL=                # e.g. gemini-3.1-flash-lite
ROLLY_HYBRID_LLM_API_KEY=
ROLLY_HYBRID_LLM_TOKEN_PARAM=          # OpenAI's current models: max_completion_tokens (default: max_tokens)
ROLLY_HYBRID_LLM_REASONING=            # e.g. none - reasoning adds seconds before the first token
# Configuration measured in the POC: base URL https://api.openai.com/v1, model gpt-6-luna,
# token param max_completion_tokens, reasoning none.

# ---- commercial realtime baselines ----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- utility LLM for session summaries (defaults to ROLLY_LLM_*) ----
ROLLY_UTILITY_LLM_BASE_URL=
ROLLY_UTILITY_LLM_MODEL=
